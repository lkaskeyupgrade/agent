-- ====================================================================
-- PREREQUISITE (run once, or whenever the source CSV changes)
-- ====================================================================

create or replace table commercial_analytics.dev.agent_email_eng as
select *
from read_files(
    '/Volumes/commercial_analytics/commercial_analytics/agent_email/dsr-3550_dec.csv',
    format => 'csv',
    header => true
);


-- ====================================================================
-- MAIN QUERY
-- Part 1: every 2026 application/loan, enriched with GUMS (test agents removed)
-- Part 2: active GUMS agents with NO 2026 activity (no_2026_activity = 1)
-- ====================================================================

create or replace table commercial_analytics.dev.agent_email_performance as

with partner_name_mapping (raw_name, canonical_name) as (
    values
        ('COLUMBUS ZOO', 'Columbus Zoo'),
        ('jetBlue Vacations', 'JetBlue Vacations'),
        ('Westjet', 'WestJet'),
        ('Beech Mountain Resorts Inc', 'Beech Mountain Resorts'),
        ('TRAVELSAVERS Inc.', 'TravelSavers'),
        ('Apple Leisure Group - B2C', 'ALG - B2C'),
        ('SkyRoute Travel Services Inc', 'SkyRoute Travel'),
        ('Flex Pay Merchant Financing', 'Flex Pay'),
        ('Allegiant Travel', 'Allegiant Air'),
        ('Interline Travel', 'Interliner'),
        ('Red Label Vacations Inc.', 'RedTag'),
        ('Sunwing Vacations', 'Sunwing Vacations Group'),
        ('JetBlue', 'JetBlue Vacations')
)

-- test agents = emails whose GUMS records are ALL up_code -99
-- (agents with both a -51 and a -99 record are real and are kept)
,test_agents as (
    select trim(lower(regexp_replace(email, '^UP-[^_]+_', ''))) as email
    from hive_metastore.bi_layer.bi_gums_agent
    group by trim(lower(regexp_replace(email, '^UP-[^_]+_', '')))
    having min(case when right(trim(up_code), 2) = '99' then 1 else 0 end) = 1
)

-- real GUMS records only (the -99 records are ignored)
-- email_key = email with the 'UP-xxxx_' prefix removed, same as the activity side
,gums as (
    select *
        ,trim(lower(regexp_replace(email, '^UP-[^_]+_', ''))) as email_key
    from hive_metastore.bi_layer.bi_gums_agent
    where up_code is null or right(trim(up_code), 2) <> '99'
)

-- one row per application; the agent with the highest agent_details_id wins
,application_agent as (
    select application_id, agent_details_id, agent_create_date, type, external_roles
    from (
        select
            a.application_id
            ,ord.agent_details_id
            ,s.create_date as agent_create_date
            ,s.type
            ,s.external_roles
            ,row_number() over (
                partition by a.application_id
                order by ord.agent_details_id desc nulls last
            ) as rn
        from commercial_analytics.public.bi_application_detailed a
            left join (
                select distinct application_id, order_details_id
                from databrickstors_canalytics_catalog.bnplapplication.action_log
                where create_date >= '2026-01-01'
                  and application_id is not null
            ) al
                on a.application_id = al.application_id
            left join databrickstors_canalytics_catalog.bnplapplication.order_request ord
                on al.order_details_id = ord.order_details_id
            left join commercial_analytics.dev.agent_email_eng s
                on ord.agent_details_id = s.id
        where a.date_etz >= '2026-01-01'
    )
    where rn = 1
)

,apps as (
    select
        a.application_id
        ,coalesce(m.canonical_name, a.partner_grouping_redshift, a.partner_grouping_legacy) as partner_group
        ,a.partner_short
        ,regexp_replace(a.agent_email, '^UP-[^_]+_', '') as cleaned_email
        ,a.date_etz as app_date
        ,aa.agent_details_id
        ,aa.agent_create_date
        ,aa.type
        ,aa.external_roles
    from commercial_analytics.public.bi_application_detailed a
        left join partner_name_mapping m
            on upper(trim(coalesce(a.partner_grouping_redshift, a.partner_grouping_legacy))) = upper(trim(m.raw_name))
        left join application_agent aa
            on a.application_id = aa.application_id
    where a.agent_email is not null
      and a.date_etz >= '2026-01-01'
      -- and lower(a.channel) = 'agent'
      and not exists (
            select 1 from test_agents t
            where t.email = trim(lower(regexp_replace(a.agent_email, '^UP-[^_]+_', '')))
      )
)

,loans as (
    select
        l.loan_id
        ,coalesce(m.canonical_name, l.partner_grouping_redshift, l.partner_grouping_legacy) as partner_group
        ,l.partner_short
        ,regexp_replace(l.agent_email, '^UP-[^_]+_', '') as cleaned_email
        ,l.date_etz as loan_date
        ,l.gmv_usd as gmv
        ,case when l.partner_confirmation is null or trim(l.partner_confirmation) = ''
              then 0
              else size(split(l.partner_confirmation, ','))
         end as cabins_booked
        ,aa.agent_details_id
        ,aa.agent_create_date
        ,aa.type
        ,aa.external_roles
    from commercial_analytics.public.bi_loan_detailed l
        left join commercial_analytics.public.bi_application_detailed la
            on l.loan_id = la.application_id
        left join partner_name_mapping m
            on upper(trim(coalesce(l.partner_grouping_redshift, l.partner_grouping_legacy))) = upper(trim(m.raw_name))
        left join application_agent aa
            on l.loan_id = aa.application_id
    where l.date_etz >= '2026-01-01'
      and l.loan_count = 1
      and (la.date_etz is null or l.date_etz >= la.date_etz)
      and lower(l.channel) = 'agent'
      and l.agent_email is not null
      and not exists (
            select 1 from test_agents t
            where t.email = trim(lower(regexp_replace(l.agent_email, '^UP-[^_]+_', '')))
      )
)

,combined as (
    select
        coalesce(a.application_id, l.loan_id) as application_id
        ,coalesce(a.cleaned_email, l.cleaned_email) as cleaned_email
        ,coalesce(a.partner_group, l.partner_group) as partner_group
        ,coalesce(a.partner_short, l.partner_short) as partner_short
        ,coalesce(a.app_date, l.loan_date) as activity_date
        ,case when a.application_id is not null then 1 else 0 end as total_applications
        ,case when l.loan_id is not null then 1 else 0 end as total_loans
        ,l.gmv
        ,l.cabins_booked
        ,coalesce(a.agent_details_id, l.agent_details_id) as agent_details_id
        ,coalesce(a.agent_create_date, l.agent_create_date) as agent_create_date
        ,coalesce(a.type, l.type) as type
        ,coalesce(a.external_roles, l.external_roles) as external_roles
    from apps a
        full outer join loans l
            on a.application_id = l.loan_id
)

,gums_matched as (
    select
        c.*
        ,g.id
        ,g.name
        ,g.family_name
        ,g.email    as gums_email
        ,g.enabled  as gums_enabled
        ,g.status   as gums_email_status
        ,g.certified
        ,g.partner  as gums_partner
        ,case
            when g.id is null then null
            when g.partner is not null and trim(g.partner) <> ''
                 and (contains(lower(c.partner_group), lower(g.partner))
                      or contains(lower(g.partner), lower(c.partner_group))) then 1
            else 0
         end as partner_match
        ,row_number() over (
            partition by c.application_id
            order by
                case
                    when g.id is null then 2
                    when g.partner is not null and trim(g.partner) <> ''
                         and (contains(lower(c.partner_group), lower(g.partner))
                              or contains(lower(g.partner), lower(c.partner_group))) then 0
                    else 1
                end,
                g.enabled desc nulls last,
                g.id
        ) as rn
    from combined c
        left join gums g
            on trim(lower(c.cleaned_email)) = g.email_key
)

-- PART 1 + PART 2 combined into one CTE so we can add the "days since last application" fields
,final_rows as (

    -- PART 1: all 2026 activity
    select
        application_id, cleaned_email, partner_group, partner_short, activity_date
        ,total_applications, total_loans, gmv, cabins_booked
        ,agent_details_id, agent_create_date, type, external_roles
        ,id, name, family_name, gums_email, gums_enabled, gums_email_status, certified
        ,gums_partner, partner_match
        ,0 as no_2026_activity
    from gums_matched
    where rn = 1

    union all

    -- PART 2: active GUMS agents with no 2026 activity at all
    select
        null                       as application_id
        ,g.email_key               as cleaned_email
        ,g.partner                 as partner_group
        ,null                      as partner_short
        ,null                      as activity_date
        ,0                         as total_applications
        ,0                         as total_loans
        ,null                      as gmv
        ,null                      as cabins_booked
        ,null                      as agent_details_id
        ,null                      as agent_create_date
        ,null                      as type
        ,null                      as external_roles
        ,g.id
        ,g.name
        ,g.family_name
        ,g.email                   as gums_email
        ,g.enabled                 as gums_enabled
        ,g.status                  as gums_email_status
        ,g.certified
        ,g.partner                 as gums_partner
        ,null                      as partner_match
        ,1                         as no_2026_activity
    from gums g
    where g.enabled = 1
      and g.status = 'CONFIRMED'
      and not exists (
            select 1 from combined c
            where trim(lower(c.cleaned_email)) = g.email_key
      )
)

-- most recent application per agent (applications only, not loan-only rows)
,agent_last_application as (
    select
        trim(lower(cleaned_email)) as email
        ,max(case when total_applications = 1 then cast(activity_date as date) end) as last_application_date
        ,sum(total_loans) as loans_2026
    from final_rows
    group by trim(lower(cleaned_email))
)

select
    f.*
    ,l.last_application_date
    ,datediff(
        cast(from_utc_timestamp(current_timestamp(), 'America/New_York') as date),
        l.last_application_date
     ) as days_since_last_application          -- NULL when the agent has no application
    ,case
        when l.last_application_date is not null then 'Has 2026 application'
        when l.loans_2026 > 0                    then 'No 2026 application (loans only)'
        else                                          'No 2026 activity'
     end as application_signal
    ,case
        when f.no_2026_activity = 1 then 'GUMS only (no 2026 activity)'
        when f.id is null           then 'Activity only (email not in GUMS)'
        when f.partner_match = 0    then 'Activity + GUMS (partner differs)'
        else                             'Activity + GUMS'
     end as agent_source
from final_rows f
    left join agent_last_application l
        on trim(lower(f.cleaned_email)) = l.email;
